  {
   "id": "f9109345-9887-5421-a3d9-417e5d368bd3",
   "tipo": "preguntas",
   "orden": 0,
   "activo": true,
   "datos": {
    "tema": "reservas",
    "pregunta": "¿Cómo se paga la reserva?",
    "respuesta": "Con un anticipo por transferencia o Nequi para confirmar; el saldo se paga al llegar. El porcentaje del anticipo lo confirma la finca."
   }
  },
  {
   "id": "1279df9d-0520-59a8-89a9-41c3ddd27f1d",
   "tipo": "preguntas",
   "orden": 1,
   "activo": true,
   "datos": {
    "tema": "reservas",
    "pregunta": "¿Puedo cancelar o cambiar la fecha?",
    "respuesta": "Por definir: la política de cancelación y cambios la publica la finca desde el panel."
   }
  },
  {
   "id": "82ef6907-d32d-511c-860f-622f1e222a65",
   "tipo": "preguntas",
   "orden": 2,
   "activo": true,
   "datos": {
    "tema": "reservas",
    "pregunta": "¿Los precios incluyen impuestos?",
    "respuesta": "Sí. Las tarifas por noche incluyen el impuesto y el seguro hotelero."
   }
  },
  {
   "id": "86d76cb4-7afd-5296-8a48-64d9cd49272b",
   "tipo": "preguntas",
   "orden": 3,
   "activo": true,
   "datos": {
    "tema": "reservas",
    "pregunta": "¿Por qué reservar directo?",
    "respuesta": "Porque no pagas comisiones de terceros y hablas directamente con la finca."
   }
  },
  {
   "id": "8187f74c-b5c4-5e8e-82ee-860c661d5c1b",
   "tipo": "preguntas",
   "orden": 4,
   "activo": true,
   "datos": {
    "tema": "estadia",
    "pregunta": "¿A qué hora es la entrada y la salida?",
    "respuesta": "La entrada es desde las 3:00 p. m. La hora de salida la confirma la finca."
   }
  },
  {
   "id": "08714eac-0014-5225-bc50-a2a412cc1588",
   "tipo": "preguntas",
   "orden": 5,
   "activo": true,
   "datos": {
    "tema": "estadia",
    "pregunta": "¿Cuál es el horario del jacuzzi?",
    "respuesta": "El jacuzzi es climatizado y funciona de 5:00 a 10:00 p. m. todos los días."
   }
  },
  {
   "id": "441f957b-76b4-5b0c-82fc-27539663aa6a",
   "tipo": "preguntas",
   "orden": 6,
   "activo": true,
   "datos": {
    "tema": "estadia",
    "pregunta": "¿El desayuno está incluido?",
    "respuesta": "Es opcional: cuesta $12.000 adicionales por persona y se pide al reservar."
   }
  },
  {
   "id": "56c57268-7ef1-5b39-ad23-e1131d5567b0",
   "tipo": "preguntas",
   "orden": 7,
   "activo": true,
   "datos": {
    "tema": "estadia",
    "pregunta": "¿Podemos cocinar?",
    "respuesta": "Sí. El kiosco tiene cocina y asador para que el grupo prepare sus comidas."
   }
  },
  {
   "id": "f0177b0f-060b-549d-9c9d-96bf6580ce92",
   "tipo": "preguntas",
   "orden": 8,
   "activo": true,
   "datos": {
    "tema": "mascotas",
    "pregunta": "¿Puedo ir con mi mascota?",
    "respuesta": "Sí. Las mascotas son bienvenidas sin costo adicional; avísanos al reservar."
   }
  },
  {
   "id": "85f67857-1386-5c40-96f3-0c6cc8401fdf",
   "tipo": "preguntas",
   "orden": 9,
   "activo": true,
   "datos": {
    "tema": "mascotas",
    "pregunta": "¿Pueden ir niños?",
    "respuesta": "Sí. Los menores de edad deben llegar acompañados por sus padres y con su documento de identidad."
   }
  },
  {
   "id": "83cd4d46-f52e-59b6-8278-28b4dd2ddca4",
   "tipo": "preguntas",
   "orden": 10,
   "activo": true,
   "datos": {
    "tema": "eventos",
    "pregunta": "¿Puedo celebrar un evento?",
    "respuesta": "Sí. Usa el cotizador de la página de eventos o escríbenos con la fecha y el número de personas."
   }
  },
  {
   "id": "c6ce5a58-7af8-58a5-a5b2-7bc33b15cbd6",
   "tipo": "preguntas",
   "orden": 11,
   "activo": true,
   "datos": {
    "tema": "eventos",
    "pregunta": "¿Qué incluye el pasadía?",
    "respuesta": "Uso de las zonas sociales de 9:00 a. m. a 5:00 p. m. por $22.000 por persona más el seguro, con un mínimo de 10 personas."
   }
  },
  {
   "id": "532b8e0e-3cd7-5646-8df7-a0c2ab655f39",
   "tipo": "preguntas",
   "orden": 12,
   "activo": true,
   "datos": {
    "tema": "eventos",
    "pregunta": "¿Cuántas personas caben con la finca completa?",
    "respuesta": "Hasta 40 personas en las 14 habitaciones, por $2.800.000 la noche (solo alojamiento)."
   }
  },
  {
   "id": "3cfdac0a-1fa6-5466-8691-cfb6e455d2eb",
   "tipo": "preguntas",
   "orden": 13,
   "activo": true,
   "datos": {
